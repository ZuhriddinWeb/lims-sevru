# ======================================================================
#  LIMS - yangi server uchun .env namunasi.
#  Loyiha ildizida  .env  nomi bilan saqlang (bat skript o'zi nusxalaydi).
#  Repoda .env.example bor bo'lsa - uni asos qilib, faqat quyidagilarni o'zgartiring.
#  APP_KEY ni QO'LDA YOZMANG: php artisan key:generate --force
#  (har serverda o'z kaliti; keyin uni o'zgartirib bo'lmaydi - kirish tokenlari/shifrlangan ma'lumot buziladi)
# ======================================================================
APP_NAME="LIMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://lims.sizning-server.uz
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ---- SQL Server ----
DB_CONNECTION=sqlsrv
DB_HOST=localhost
# nomlangan nusxa bo'lsa:  DB_HOST=localhost\SQLEXPRESS  (shunda DB_PORT qatorini o'chiring)
DB_PORT=1433
DB_DATABASE=lims_yangi
DB_USERNAME=lims_user
DB_PASSWORD=KUCHLI_PAROL
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true
# DB_INTEGER_IDS ni YOZMANG (yoki true qoldiring). false qilinsa natija kiritish 404 beradi.

# ---- kesh / sessiya / navbat: bazaga yuk tushmasin ----
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- brauzer shu manzildan kiradi (CORS) - sayt manzili(lari) vergul bilan ----
CORS_ALLOWED_ORIGINS=http://lims.sizning-server.uz

# ---- Yordamchi (offline FAQ-yordamchi). false - butun tizim bo'yicha o'chiradi ----
HELP_ENABLED=true

# ---- Qoralama buyurtma: yuborilgan, lekin olib kelinmagan buyurtma necha kundan keyin «muddati o'tgan» ----
SAMPLE_REQUEST_EXPIRE_DAYS=14

# ---- pochta (eslatmalar faqat tizim ichida; pochta kerak bo'lmasa shunday qoldiring) ----
MAIL_MAILER=log

# ---- AI (ixtiyoriy). Kalit kerak emas, 'local' - tashqi xizmatsiz ----
AI_PROVIDER=local
